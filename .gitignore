bench/longmemeval/data/locomo_repo/
bench/longmemeval/data/locomo_v2/

# Bench LLM endpoint config (contains credentials, not committed)
bench/*/config/llm*.json

_debug_*.py
_run_*.py

# 本地运行配置实例（密钥经 ${VAR} 走环境变量；配置本身每环境不同、不入库）
mcs.yaml

