classDiagram
    direction TB

    class Plugin {
        <<ABC · 根基类>>
        +get_name() str
        +get_type() PluginType
        +get_types() set~PluginType~
        +get_priority() int
        +execute(**kwargs) Any
        +initialize(context)
        +shutdown()
    }

    class EntryPluginInterface {
        <<ABC · ENTRY>>
        +locate(query, ctx) list~Node~
        +exclusive
    }

    class TrimPluginInterface {
        <<ABC · TRIM>>
        +trim(...)
    }

    class LLMInterface {
        <<ABC · LLM>>
        +call(purpose, nodes_in?, free_args?) Any
    }

    class NodeExtensionInterface {
        <<ABC · NODE_EXTENSION>>
        +schema / default
        +serialize / deserialize
        +render(node, purpose)
    }

    class StorageSchemaExtensionInterface {
        <<ABC · STORAGE_SCHEMA_EXT>>
        +node_columns()
        +auxiliary_tables()
    }

    class AliasEntry
    class HubFallback
    class PriorityTrim
    class DeepSeekLLM
    class SourceTracking {
        <<多接口: NODE_EXTENSION + STORAGE_SCHEMA_EXT>>
    }

    Plugin <|-- EntryPluginInterface
    Plugin <|-- TrimPluginInterface
    Plugin <|-- LLMInterface
    Plugin <|-- NodeExtensionInterface
    Plugin <|-- StorageSchemaExtensionInterface

    EntryPluginInterface <|-- AliasEntry
    EntryPluginInterface <|-- HubFallback
    TrimPluginInterface <|-- PriorityTrim
    LLMInterface <|-- DeepSeekLLM

    NodeExtensionInterface <|-- SourceTracking
    StorageSchemaExtensionInterface <|-- SourceTracking

