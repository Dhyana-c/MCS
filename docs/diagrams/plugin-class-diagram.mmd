    style LLMInterface fill:#87CEEB,stroke:#333,color:#001a66
    style NodeExtensionInterface fill:#87CEEB,stroke:#333,color:#001a66
    style StorageSchemaExtensionInterface fill:#87CEEB,stroke:#333,color:#001a66
    style AliasEntry fill:#90EE90,stroke:#333,color:#003300
    style HubFallback fill:#90EE90,stroke:#333,color:#003300
    style PriorityTrim fill:#90EE90,stroke:#333,color:#003300
